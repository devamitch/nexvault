{
  "name": "nexvault",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "macos": "expo run:macos",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"*.{ts,tsx,json,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "build:web": "expo export --platform web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild",
    "prepare": "husky",
    "generate-assets2": "node scripts/generate-assets.js",
    "generate-assets": "pip3 install Pillow -q && python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/elements": "^2.6.4",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@shopify/react-native-skia": "2.4.18",
    "date-fns": "^4.1.0",
    "eventemitter3": "^5.0.4",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.8",
    "expo-audio": "~55.0.8",
    "expo-camera": "~55.0.9",
    "expo-clipboard": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-contacts": "~55.0.8",
    "expo-crypto": "~55.0.8",
    "expo-dev-client": "~55.0.10",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-gl": "~55.0.9",
    "expo-haptics": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-local-authentication": "~55.0.8",
    "expo-location": "~55.1.2",
    "expo-media-library": "~55.0.9",
    "expo-network": "~55.0.8",
    "expo-sensors": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-speech": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-three": "^8.0.0",
    "expo-video": "~55.0.10",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2",
    "react-native-worklets-core": "^1.6.3",
    "three": "^0.183.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@commitlint/cli": "~19.5.0",
    "@commitlint/config-conventional": "~19.5.0",
    "@eslint/js": "~9.12.0",
    "@expo/webpack-config": "~19.0.0",
    "@napi-rs/canvas": "^0.1.95",
    "@testing-library/jest-native": "~5.4.0",
    "@testing-library/react-native": "~12.8.0",
    "@types/jest": "~29.5.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.1.7",
    "@types/three": "~0.169.0",
    "@types/uuid": "~10.0.0",
    "@typescript-eslint/eslint-plugin": "~8.8.0",
    "@typescript-eslint/parser": "~8.8.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "~9.12.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-plugin-react": "~7.37.0",
    "eslint-plugin-react-hooks": "~5.0.0",
    "husky": "~9.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "lint-staged": "~15.2.0",
    "patch-package": "^8.0.1",
    "prettier": "~3.3.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "~29.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterSetup": [
      "./src/__tests__/setup.ts"
    ],
    "setupFiles": [
      "./src/__tests__/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/react-native-skia|react-native-reanimated|zustand|three|@react-three)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "private": true
}
